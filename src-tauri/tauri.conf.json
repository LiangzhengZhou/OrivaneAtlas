{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orivane Atlas",
  "version": "1.1.1",
  "identifier": "app.orivane.atlas",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../apps/web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orivane Atlas",
        "width": 1280,
        "height": 840,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'self'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' data:; object-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBNjg2RjY5ODMwREQ1QUQKUldTdDFRMkRhVzlvYWtiQnVOOC9PK3hQdUpZeHlMSk1GcVQva3J6TUhvckJRTTJBcFYzdlNzN0oK",
      "endpoints": [
        "https://github.com/LiangzhengZhou/OrivaneAtlas/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
